@model _25DH110393_MyStore.Models.VỉewModel.MyOrderVM
@using _25DH110393_MyStore.Models.VỉewModel
@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Số đơn của 1 trạng thái (không có thì 0)
    Func<string, int> countOf = s => Model.StatusCounts.ContainsKey(s) ? Model.StatusCounts[s] : 0;
}

<style>
    .order-search {
        display: flex;
        gap: 8px;
        max-width: 650px;
        margin-top: 10px;
    }

        .order-search input[type=text] {
            flex: 1;
            padding: 8px 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .order-search button {
            padding: 8px 18px;
            background: brown;
            color: #fff;
            border: none;
            border-radius: 5px;
        }

        .order-search a {
            align-self: center;
        }

    .order-tabs {
        display: flex;
        flex-wrap: wrap;
        border-bottom: 2px solid #eee;
        margin: 20px 0 10px;
    }

        .order-tabs a {
            padding: 10px 16px;
            color: #555;
            text-decoration: none;
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
        }

            .order-tabs a:hover {
                color: brown;
            }

            .order-tabs a.active {
                color: brown;
                border-bottom-color: brown;
                font-weight: bold;
            }

    .order-group {
        margin-top: 25px;
        color: #444;
    }

    .order-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 10px;
        margin: 12px 0;
    }

    .order-head, .order-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding: 10px 15px;
        background: #fafafa;
    }

    .order-head {
        border-bottom: 1px solid #eee;
        border-radius: 10px 10px 0 0;
    }

    .order-foot {
        border-top: 1px solid #eee;
        border-radius: 0 0 10px 10px;
    }

    .order-status {
        color: #fff;
        padding: 3px 12px;
        border-radius: 12px;
        font-size: 13px;
    }

    .order-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 8px 15px;
    }

        .order-item img {
            width: 60px;
            height: 60px;
            object-fit: contain;
        }

    .order-item-name {
        flex: 1;
    }

    .order-item-price {
        min-width: 110px;
        text-align: right;
    }

    .ob {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 5px;
        border: 1px solid;
        font-size: 14px;
        text-decoration: none;
        background: #fff;
        cursor: pointer;
        margin-left: 4px;
    }

    .ob-blue {
        color: #007bff;
        border-color: #007bff;
    }

    .ob-red {
        color: #fff;
        background: #dc3545;
        border-color: #dc3545;
    }

    .ob-gray {
        color: #6c757d;
        border-color: #6c757d;
    }

    .order-empty {
        padding: 40px;
        text-align: center;
        color: #888;
    }
</style>

<h2>ĐƠN HÀNG CỦA TÔI</h2>

@if (TempData["Success"] != null)
{<div class="alert alert-success">@TempData["Success"]</div>}
@if (TempData["Error"] != null)
{<div class="alert alert-danger">@TempData["Error"]</div> }

@* ===== TÌM KIẾM ===== *@
@using (Html.BeginForm("MyOrder", "Order", FormMethod.Get, new { @class = "order-search" }))
{
    <input type="hidden" name="status" value="@Model.Status" />
    <input type="text" name="search" value="@Model.Search" placeholder="Tìm theo mã đơn hàng hoặc tên sản phẩm" />
    <button type="submit">Tìm</button>
    if (!string.IsNullOrEmpty(Model.Search))
    {
        <a href="@Url.Action("MyOrder", new { status = Model.Status })">Xoá tìm kiếm</a>
    }
}

@* ===== CÁC TAB TRẠNG THÁI ===== *@
<div class="order-tabs">
    <a href="@Url.Action("MyOrder", new { search = Model.Search })"
       class="@(string.IsNullOrEmpty(Model.Status) ? "active" : "")">Tất cả đơn (@Model.TotalCount)</a>
    @foreach (var s in MyOrderVM.Statuses)
    {
        <a href="@Url.Action("MyOrder", new { status = s, search = Model.Search })"
           class="@(Model.Status == s ? "active" : "")">@s (@(countOf(s)))</a>
    }
</div>

@* ===== DANH SÁCH ĐƠN ===== *@
@if (!Model.Orders.Any())
{
    <p class="order-empty">Không có đơn hàng nào.</p>
}
else if (string.IsNullOrEmpty(Model.Status))
{
    // Tab "Tất cả": gom nhóm theo trạng thái
    foreach (var s in MyOrderVM.Statuses)
    {
        var group = Model.Orders.Where(o => o.OrderStatus == s).ToList();
        if (group.Any())
        {
            <h4 class="order-group">@s (@group.Count)</h4>
            foreach (var o in group)
            {
                @Html.Partial("_OrderCard", o)
            }
        }
    }
}
else
{
    foreach (var o in Model.Orders)
    {
        @Html.Partial("_OrderCard", o)
    }
}