﻿@model _25DH110393_MyStore.Models.VỉewModel.Cart

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .shoppingcart {
        background-color: ghostwhite;
    }

    .cart-section {
        background-color: white;
        border: 1px groove #ffffff;
        border-radius: 10px;
        padding: 10px 5px;
        margin: 10px;
    }

    .cart-button {
        width: 250px;
        border: 1px solid #808080;
        margin: 5px;
    }

    .shoppingcart tr {
        font-size: smaller;
    }
</style>
<script>
function cartUpdateQuanity(  id=0 , newQuantity=1) {
    if (newQuantity < 1) return;
    const form = document.createElement('form');
        form.method = 'post';
        form.action = '@Url.Action("UpdateQuantity", "Cart")';

        const idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = 'id';
        idInput.value = String(id);
        form.appendChild(idInput);

        const quantityInput = document.createElement('input');
        quantityInput.type = 'hidden';
        quantityInput.name = 'quantity';
        quantityInput.value = String(newQuantity);
        form.appendChild(quantityInput);

        document.body.appendChild(form);
        form.submit();
    }
</script>
<div>
    <h2>GIỎ HÀNG</h2>
    <div class="shoppingcart">

        @if (Model == null || !Model.Items.Any())
        {
            <p>Bạn chưa có sản phẩm nào trong giỏ.</p>
        }
        else
        {
            <div class="col-md-8">
                <div class="cart-section">
                    @foreach (var categoryGroup in Model.GroupedItems)
                    {
                        <h3>@categoryGroup.Key</h3>
                        <table class="table cart-section">
                            <thead>
                                <tr>
                                    <th colspan="2">Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in categoryGroup)
                                {
                                    <tr>
                                        <td><img src="@item.ProductImage" alt="@item.ProductName" style="max-height:80px;" /></td>
                                        <td class="col-md-3">@item.ProductName</td>
                                        <td>
                                            <button type="button" style="width: 20px;" onclick="cartUpdateQuantity(@item.ProductID @item.Quantity - 1)">-</button>
                                            <input type="number" value="@item.Quantity" style="width: 40px; text-align:right;" readonly />
                                            <button type="button" style="width: 20px;" onclick="cartUpdateQuantity(@item.ProductID @item.Quantity + 1)">+</button>
                                        </td>
                                        <td>@item.UnitPrice.ToString("N0")</td>
                                        <td>@item.TotalPrice.ToString("N0")</td>
                                        <td>
                                            <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" title="Xóa sản phẩm này">
                                                <img src="~/Images/remove.png" style="max-height:20px;" />
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="col-md-3 cart-section">
                <div><strong>Tổng giá trị: &nbsp;<span style="color: red;">@Model.TotalValue().ToString("N0")</span></strong></div>
                <div>@Html.ActionLink("Mua hàng", "Checkout", "Order", null, new { @class = "btn btn-danger cart-button" })</div>
                <div>@Html.ActionLink("Xóa tất cả", "ClearCart", "Cart", null, new { @class = "btn btn-default cart-button" })</div>
            </div>
        }
    </div>

    @if (Model != null && Model.SimilarProducts != null)
    {
        <div class="col-md-12 cart-section">@Html.Partial("_PVSimilarProduct", Model)</div>
    }
    <div class="col-md-12">@Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-warning cart-button" })</div>
</div>