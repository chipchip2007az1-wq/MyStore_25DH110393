@model _25DH110393_MyStore.Models.VỉewModel.ProductSearchVM
  @using PagedList.Mvc
<head>
    <style>
        img {
            height: 200px;
            width: 200px;
        }
    </style>
</head>
<!--hiển thị danh sách sản phẩm-->
@if (Model.Products != null && Model.Products.Any())

{
    <h2 class="bg-success">DANH SÁCH SẢN PHẨM </h2>


    <table class="table bg-info container-fluid" img>
        <thead>
            <tr>
                <th class="bg-success col-md-3">
                    Tên sản phẩm
                </th>
                <th class="bg-success col-md-2">
                    Mô tả
                </th>
                <th class="bg-success col-md-1">
                    Đơn giá
                </th>
                <th class="bg-success col-md-2">
                    Hình ảnh
                </th>
                <th class="bg-success col-md-4">
                    Danh mục
                </th>
                <th class="bg-success"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductDescription)

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductPrice)

                    </td>
                    <td>
                        <img src="@Html.DisplayFor(modelItem => item.ProductImage)" style="width:200px;height:200px;" />
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Category.CategoryName)
                    </td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary tbn-sm" }) |
                        @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary tbn-sm" }) |
                        @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary tbn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <!--Hiển thị phân trang-->
    <div class="pagination-container">
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new {page ,searchTerm = Model.SearchTerm,minPrice = Model.MinPrice, maxPrice = Model.MaxPrice,sortOrder = Model.SortOrder}))
        </div>
}
else
{
    <p>Không tìm được sản phẩm phù hợp</p>
}
<div class="form-group">
    <div class="col-md-offset-8 col-md-4">
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
    </div>
</div>

